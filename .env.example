# Copy this file to .env and fill in your local values. .env is gitignored so
# the key never leaves your machine.
#
# Generate the key once:
#
#   echo "PHILTER_WORKSPACE_CRYPTO_SECRET=$(openssl rand -base64 32)" > .env
#
# The value must be base64-encoded 32 random bytes. Philter Workspace refuses to start
# if it's unset, not valid base64, or doesn't decode to exactly 32 bytes —
# this protects deployments from running with a public dev key or a
# brute-forceable passphrase.
PHILTER_WORKSPACE_CRYPTO_SECRET=replace-me-with-base64-of-32-random-bytes

# Database: docker-compose.yaml uses sqlite, kept in the philter-workspace-data volume.
# To use MongoDB instead, set this and start compose with --profile mongodb.
# See docs/docs/reference/database.md.
# PHILTER_WORKSPACE_STORE=mongodb

# docker-compose.prod.yaml (Philter Workspace and Philter, both on SQLite) also needs:
# PHILTER_ENCRYPTION_KEY=   # openssl rand -base64 32
# PHILTER_BOOTSTRAP_API_KEY=sk_   # followed by 32 letters and digits
# PHILTER_WORKSPACE_PHILTER_API_KEY=   # created in Philter, see the top of docker-compose.prod.yaml
# VALKEY_PASSWORD=
# Only with the optional mutual TLS settings in docker-compose.prod.yaml:
# PHILTER_WORKSPACE_PHILTER_TLS_KEY_STORE_PASSWORD=
# PHILTER_WORKSPACE_PHILTER_TLS_TRUST_STORE_PASSWORD=
