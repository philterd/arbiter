# Copy this file to .env and fill in your local values. .env is gitignored so
# the key never leaves your machine.
#
# Generate the key once:
#
#   echo "ARBITER_CRYPTO_SECRET=$(openssl rand -base64 32)" > .env
#
# The value must be base64-encoded 32 random bytes. Arbiter refuses to start
# if it's unset, not valid base64, or doesn't decode to exactly 32 bytes —
# this protects deployments from running with a public dev key or a
# brute-forceable passphrase.
ARBITER_CRYPTO_SECRET=replace-me-with-base64-of-32-random-bytes
